{
  "schema": "dev.dory.sandbox.template",
  "version": 1,
  "id": "coding-agent",
  "displayName": "Coding Agent",
  "summary": "A secure general-purpose coding workspace with Dory's core agent tools.",
  "profile": "core",
  "tools": [],
  "networkPolicy": "none",
  "allowNetwork": [],
  "mounts": [],
