diff --git a/pkg/services/forwarder/connectivity.go b/pkg/services/forwarder/connectivity.go
new file mode 100644
index 0000000..95d113c
--- /dev/null
+++ b/pkg/services/forwarder/connectivity.go
@@ -0,0 +1,25 @@
+package forwarder
+
+import (
+	"sync"
+
+	"gvisor.dev/gvisor/pkg/tcpip"
+)
+
+// resolveDestination is the single outbound policy boundary for both TCP and UDP. Host-only
+// traffic must match an explicit virtual-host NAT mapping; arbitrary guest destinations are
+// rejected before Go's host network APIs are invoked.
+func resolveDestination(
+	destination tcpip.Address,
+	nat map[tcpip.Address]tcpip.Address,
+	natLock *sync.Mutex,
+	allowExternal bool,
+) (tcpip.Address, bool) {
+	natLock.Lock()
+	replacement, hostMapping := nat[destination]
+	natLock.Unlock()
+	if hostMapping {
+		return replacement, true
+	}
+	return destination, allowExternal
+}
diff --git a/pkg/services/forwarder/connectivity_test.go b/pkg/services/forwarder/connectivity_test.go
new file mode 100644
index 0000000..3c7ab17
--- /dev/null
+++ b/pkg/services/forwarder/connectivity_test.go
@@ -0,0 +1,29 @@
+package forwarder
+
+import (
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"gvisor.dev/gvisor/pkg/tcpip"
+)
+
+func TestHostOnlyConnectivityPermitsOnlyExplicitHostMappings(t *testing.T) {
+	hostAlias := tcpip.AddrFrom4([4]byte{192, 168, 127, 254})
+	hostLoopback := tcpip.AddrFrom4([4]byte{127, 0, 0, 1})
+	external := tcpip.AddrFrom4([4]byte{203, 0, 113, 10})
+	nat := map[tcpip.Address]tcpip.Address{hostAlias: hostLoopback}
+	var lock sync.Mutex
+
+	resolved, allowed := resolveDestination(hostAlias, nat, &lock, false)
+	require.True(t, allowed)
+	require.Equal(t, hostLoopback, resolved)
+
+	resolved, allowed = resolveDestination(external, nat, &lock, false)
+	require.False(t, allowed)
+	require.Equal(t, external, resolved)
+
+	resolved, allowed = resolveDestination(external, nat, &lock, true)
+	require.True(t, allowed)
+	require.Equal(t, external, resolved)
+}
