diff --git a/pkg/services/dns/dns_test.go b/pkg/services/dns/dns_test.go
index 745be98..d1b8a08 100644
--- a/pkg/services/dns/dns_test.go
+++ b/pkg/services/dns/dns_test.go
@@ -402,0 +403,20 @@ func TestAAAAAnswersAreInhibitedWithoutRoutableHostIPv6(t *testing.T) {
+func TestHostOnlyDNSAnswersLocalZonesWithoutConsultingUpstream(t *testing.T) {
+	server, err := NewWithExternalResolution(nil, nil, []types.Zone{{
+		Name:    "internal.",
+		Records: []types.Record{{Name: "host", IP: net.ParseIP("192.168.127.254")}},
+	}}, false)
+	require.NoError(t, err)
+
+	local := new(dns.Msg)
+	local.SetQuestion("host.internal.", dns.TypeA)
+	server.handler.addAnswers(local)
+	require.Len(t, local.Answer, 1)
+	require.Equal(t, "192.168.127.254", local.Answer[0].(*dns.A).A.String())
+
+	external := new(dns.Msg)
+	external.SetQuestion("example.com.", dns.TypeA)
+	server.handler.addAnswers(external)
+	require.Equal(t, dns.RcodeNameError, external.Rcode)
+	require.Empty(t, external.Answer)
+}
