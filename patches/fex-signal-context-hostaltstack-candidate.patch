diff --git a/Source/Tools/LinuxEmulation/ArchHelpers/X64SignalFrameContext.h b/Source/Tools/LinuxEmulation/ArchHelpers/X64SignalFrameContext.h
new file mode 100644
index 000000000..1c14a646e
--- /dev/null
+++ b/Source/Tools/LinuxEmulation/ArchHelpers/X64SignalFrameContext.h
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include "UContext.h"
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+namespace FEX::ArchHelpers::Context {
+
+struct X64PublishedSignalFrame {
+  bool Valid {};
+  bool HasYMM {};
+  uint64_t RIP {};
+  uint32_t EFL {};
+  uint64_t CSSS {};
+  uint64_t GRegs[16] {};
+  uint64_t FPStateLocation {};
+  uint32_t MXCSR {};
+  uint16_t FCW {};
+  uint16_t FSW {};
+  uint8_t FTW {};
+  __uint128_t ST[8] {};
+  __uint128_t XMM[16] {};
+  __uint128_t YMMH[16] {};
+};
+
+constexpr uint32_t RestoredEFLAGSMask = ~(uint32_t {(1U << 1) | (1U << 9)});
+constexpr uint32_t RestoredMXCSRMask = 0xFFC0;
+constexpr uint16_t RestoredFSWMask = 0x7F01;
+constexpr uint64_t RestoredCSGSFSMask = 0xFFFF000000000000ULL | 0xFFFFULL;
+constexpr size_t RestoredX87Bytes = 10;
+
+static inline const uint64_t* RestoredGRegPointers_x64(const FEXCore::x86_64::ucontext_t* guest_uctx) {
+  return &guest_uctx->uc_mcontext.gregs[FEXCore::x86_64::FEX_REG_R8];
+}
+
+template<typename ContextBackupType>
+static inline void CapturePublishedSignalFrame_x64(ContextBackupType* Context, const FEXCore::x86_64::ucontext_t* guest_uctx, bool SupportsAVX) {
+  auto& Published = Context->PublishedX64SignalFrame;
+  Published.Valid = true;
+  Published.HasYMM = SupportsAVX;
+  Published.RIP = guest_uctx->uc_mcontext.gregs[FEXCore::x86_64::FEX_REG_RIP];
+  Published.EFL = static_cast<uint32_t>(guest_uctx->uc_mcontext.gregs[FEXCore::x86_64::FEX_REG_EFL]) & RestoredEFLAGSMask;
+  Published.CSSS = guest_uctx->uc_mcontext.gregs[FEXCore::x86_64::FEX_REG_CSGSFS] & RestoredCSGSFSMask;
+  memcpy(Published.GRegs, RestoredGRegPointers_x64(guest_uctx), sizeof(Published.GRegs));
+  Published.FPStateLocation = reinterpret_cast<uint64_t>(guest_uctx->uc_mcontext.fpregs);
+
+  // The guest-visible fpstate is owned by the FEX-created signal frame. If the guest changes the
+  // fpregs pointer, X64SignalFrameChanged detects that before dereferencing the replacement.
+  auto* xstate = reinterpret_cast<const FEXCore::x86_64::xstate*>(guest_uctx->uc_mcontext.fpregs);
+  auto* fpstate = &xstate->fpstate;
+  Published.MXCSR = fpstate->mxcsr & RestoredMXCSRMask;
+  Published.FCW = fpstate->fcw;
+  Published.FSW = fpstate->fsw & RestoredFSWMask;
+  Published.FTW = static_cast<uint8_t>(fpstate->ftw);
+  for (size_t i = 0; i < sizeof(Published.ST) / sizeof(Published.ST[0]); ++i) {
+    memcpy(&Published.ST[i], &fpstate->_st[i], RestoredX87Bytes);
+  }
+  memcpy(Published.XMM, fpstate->_xmm, sizeof(Published.XMM));
+  if (SupportsAVX) {
+    memcpy(Published.YMMH, xstate->ymmh.ymmh_space, sizeof(Published.YMMH));
+  }
+}
+
+template<typename ContextBackupType>
+static inline bool X64SignalFrameChanged(const ContextBackupType* Context, const FEXCore::x86_64::ucontext_t* guest_uctx, bool SupportsAVX) {
+  const auto& Published = Context->PublishedX64SignalFrame;
+  if (!Published.Valid) {
+    return true;
+  }
+
+  if (Published.RIP != guest_uctx->uc_mcontext.gregs[FEXCore::x86_64::FEX_REG_RIP] ||
+      Published.EFL != (static_cast<uint32_t>(guest_uctx->uc_mcontext.gregs[FEXCore::x86_64::FEX_REG_EFL]) & RestoredEFLAGSMask) ||
+      Published.CSSS != (guest_uctx->uc_mcontext.gregs[FEXCore::x86_64::FEX_REG_CSGSFS] & RestoredCSGSFSMask)) {
+    return true;
+  }
+
+  if (memcmp(Published.GRegs, RestoredGRegPointers_x64(guest_uctx), sizeof(Published.GRegs)) != 0) {
+    return true;
+  }
+
+  if (Published.FPStateLocation != reinterpret_cast<uint64_t>(guest_uctx->uc_mcontext.fpregs)) {
+    return true;
+  }
+
+  if (Published.HasYMM != SupportsAVX) {
+    return true;
+  }
+
+  auto* xstate = reinterpret_cast<const FEXCore::x86_64::xstate*>(guest_uctx->uc_mcontext.fpregs);
+  auto* fpstate = &xstate->fpstate;
+  if (Published.MXCSR != (fpstate->mxcsr & RestoredMXCSRMask) || Published.FCW != fpstate->fcw ||
+      Published.FSW != (fpstate->fsw & RestoredFSWMask) || Published.FTW != static_cast<uint8_t>(fpstate->ftw)) {
+    return true;
+  }
+
+  for (size_t i = 0; i < sizeof(Published.ST) / sizeof(Published.ST[0]); ++i) {
+    if (memcmp(&Published.ST[i], &fpstate->_st[i], RestoredX87Bytes) != 0) {
+      return true;
+    }
+  }
+  if (memcmp(Published.XMM, fpstate->_xmm, sizeof(Published.XMM)) != 0) {
+    return true;
+  }
+  if (SupportsAVX && memcmp(Published.YMMH, xstate->ymmh.ymmh_space, sizeof(Published.YMMH)) != 0) {
+    return true;
+  }
+
+  return false;
+}
+
+} // namespace FEX::ArchHelpers::Context
