+static bool SignalFrameChanged_x64(FEXCore::Context::Context* CTX, FEXCore::Core::InternalThreadState* Thread,
+                                   ArchHelpers::Context::ContextBackup* Context,
+                                   const FEXCore::x86_64::ucontext_t* guest_uctx, bool SupportsAVX) {
+  if (Context->OriginalRIP != guest_uctx->uc_mcontext.gregs[FEXCore::x86_64::FEX_REG_RIP]) {
+    return true;
+  }
+
+  const auto& OriginalState = Context->GuestState;
+
+#define COMPARE_REG(x)                                                                                                    \
+  do {                                                                                                                    \
+    if (OriginalState.gregs[FEXCore::X86State::REG_##x] != guest_uctx->uc_mcontext.gregs[FEXCore::x86_64::FEX_REG_##x]) { \
+      return true;                                                                                                        \
+    }                                                                                                                     \
+  } while (false)
+  COMPARE_REG(R8);
+  COMPARE_REG(R9);
+  COMPARE_REG(R10);
+  COMPARE_REG(R11);
+  COMPARE_REG(R12);
+  COMPARE_REG(R13);
+  COMPARE_REG(R14);
+  COMPARE_REG(R15);
+  COMPARE_REG(RDI);
+  COMPARE_REG(RSI);
+  COMPARE_REG(RBP);
+  COMPARE_REG(RBX);
+  COMPARE_REG(RDX);
+  COMPARE_REG(RAX);
+  COMPARE_REG(RCX);
+  COMPARE_REG(RSP);
+#undef COMPARE_REG
+
+  const uint64_t OriginalCSGSFS = ((uint64_t)OriginalState.ss_idx << 48) | ((uint64_t)OriginalState.fs_idx << 32) |
+                                  ((uint64_t)OriginalState.gs_idx << 16) | ((uint64_t)OriginalState.cs_idx << 0);
+  if (OriginalCSGSFS != guest_uctx->uc_mcontext.gregs[FEXCore::x86_64::FEX_REG_CSGSFS]) {
+    return true;
+  }
+
+  if (CTX->ReconstructCompactedEFLAGS(Thread, false, nullptr, 0) != guest_uctx->uc_mcontext.gregs[FEXCore::x86_64::FEX_REG_EFL]) {
+    return true;
+  }
+
+  if (reinterpret_cast<uint64_t>(guest_uctx->uc_mcontext.fpregs) != Context->FPStateLocation) {
+    return true;
+  }
+
+  auto* xstate = reinterpret_cast<const FEXCore::x86_64::xstate*>(guest_uctx->uc_mcontext.fpregs);
+  auto* fpstate = &xstate->fpstate;
+
+  if ((fpstate->mxcsr & 0xFFC0) != (OriginalState.mxcsr & 0xFFC0) || fpstate->fcw != OriginalState.FCW ||
+      fpstate->ftw != OriginalState.AbridgedFTW) {
+    return true;
+  }
+
+  if (((fpstate->fsw >> 0) & 1) != OriginalState.flags[FEXCore::X86State::X87FLAG_IE_LOC] ||
+      ((fpstate->fsw >> 8) & 1) != OriginalState.flags[FEXCore::X86State::X87FLAG_C0_LOC] ||
+      ((fpstate->fsw >> 9) & 1) != OriginalState.flags[FEXCore::X86State::X87FLAG_C1_LOC] ||
+      ((fpstate->fsw >> 10) & 1) != OriginalState.flags[FEXCore::X86State::X87FLAG_C2_LOC] ||
+      ((fpstate->fsw >> 14) & 1) != OriginalState.flags[FEXCore::X86State::X87FLAG_C3_LOC] ||
+      ((fpstate->fsw >> 11) & 0b111) != OriginalState.flags[FEXCore::X86State::X87FLAG_TOP_LOC]) {
+    return true;
+  }
+
+  const uint16_t CurrentOffset = OriginalState.flags[FEXCore::X86State::X87FLAG_TOP_LOC];
+  for (size_t i = 0; i < FEXCore::Core::CPUState::NUM_MMS; ++i) {
+    const auto modulo_i = (i + CurrentOffset) % 8;
+    if (memcmp(&OriginalState.mm[modulo_i], &fpstate->_st[i], sizeof(OriginalState.mm[0])) != 0) {
+      return true;
+    }
+  }
+
+  __uint128_t XMM_Low[FEXCore::Core::CPUState::NUM_XMMS] {};
+  __uint128_t YMM_High[FEXCore::Core::CPUState::NUM_XMMS] {};
+  CTX->ReconstructXMMRegisters(Thread, XMM_Low, SupportsAVX ? YMM_High : nullptr);
+  if (memcmp(XMM_Low, fpstate->_xmm, sizeof(XMM_Low)) != 0) {
+    return true;
+  }
+  if (SupportsAVX && memcmp(YMM_High, xstate->ymmh.ymmh_space, sizeof(YMM_High)) != 0) {
+    return true;
+  }
+
+  return false;
+}
