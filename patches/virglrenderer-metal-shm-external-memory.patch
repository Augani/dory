+void *
+vkr_metal_buffer_retain(void *mtl_buffer)
+{
+   if (mtl_buffer)
+      CFRetain((CFTypeRef)mtl_buffer);
+   return mtl_buffer;
+}
+
+void
+vkr_metal_buffer_release(void *mtl_buffer)
+{
+   if (mtl_buffer)
+      CFRelease((CFTypeRef)mtl_buffer);
+}
