# The legacy compute-only Venus profile uses 16 KiB guest pages to match Apple Silicon's
# Hypervisor.framework mapping granule. The accelerated-desktop profile deliberately overrides this
# to 4 KiB for its userspace ABI; patch 0006 independently aligns its host-visible GPU aperture.
CONFIG_ARM64_16K_PAGES=y

# Experimental Venus renderer support layered on dory-virtual-display.fragment.
CONFIG_DMABUF_HEAPS=y
CONFIG_UDMABUF=y

CONFIG_DRM_FBDEV_EMULATION=n
CONFIG_FB=n
CONFIG_FB_VIRTUAL=n
