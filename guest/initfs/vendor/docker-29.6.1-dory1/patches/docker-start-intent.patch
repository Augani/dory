+package daemon
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	containerd "github.com/containerd/containerd/v2/client"
+	containertypes "github.com/moby/moby/api/types/container"
+	"github.com/moby/moby/v2/daemon/container"
+	libcontainerdtypes "github.com/moby/moby/v2/daemon/internal/libcontainerd/types"
+	"gotest.tools/v3/assert"
+	is "gotest.tools/v3/assert/cmp"
+)
+
+type startIntentMockTask struct {
+	libcontainerdtypes.Task
+	pid    uint32
+	starts int
+	err    error
+}
+
+func (t *startIntentMockTask) Pid() uint32 { return t.pid }
+
+func (t *startIntentMockTask) Start(context.Context) error {
+	t.starts++
+	return t.err
+}
+
+type startIntentMockContainer struct {
+	libcontainerdtypes.Container
+}
+
+func (i *fakeImageService) GetLayerMountID(string) (string, error) {
+	return "", errors.New("layer mount not found")
+}
+
+func newStartIntentDaemon(t *testing.T) (*Daemon, *container.Container) {
+	t.Helper()
+	store := container.NewMemoryStore()
+	replica, err := container.NewViewDB()
+	assert.NilError(t, err)
+	d := &Daemon{containers: store, containersReplica: replica}
+
+	root := t.TempDir()
+	ctr := container.NewBaseContainer("dory-start-intent-container", root)
+	ctr.Config = &containertypes.Config{}
+	ctr.HostConfig = &containertypes.HostConfig{}
+	store.Add(ctr.ID, ctr)
+	return d, ctr
+}
+
+func reloadStartIntentContainer(t *testing.T, ctr *container.Container) *container.Container {
+	t.Helper()
+	loaded := container.NewBaseContainer(ctr.ID, ctr.Root)
+	assert.NilError(t, loaded.FromDisk())
+	return loaded
+}
+
+func TestStartIntentCheckpointFailureDoesNotStartTask(t *testing.T) {
+	d, _ := newStartIntentDaemon(t)
+	ctr := container.NewBaseContainer("dory-start-intent-checkpoint-fails", filepath.Join(t.TempDir(), "missing", "root"))
+	ctr.Config = &containertypes.Config{}
+	ctr.HostConfig = &containertypes.HostConfig{}
+	tsk := &startIntentMockTask{pid: 733}
+
+	ctr.Lock()
+	err := d.startContainerTaskWithIntent(context.Background(), ctr, tsk, time.Now())
+	ctr.Unlock()
+
+	assert.Check(t, err != nil)
+	assert.Equal(t, tsk.starts, 0)
+	assert.Assert(t, !ctr.HasStartIntent())
+}
+
+func TestTaskStartFailureCleanupClearsIntentOnDisk(t *testing.T) {
+	d, ctr := newStartIntentDaemon(t)
+	tsk := &startIntentMockTask{pid: 733, err: errors.New("synthetic task start failure")}
+
+	ctr.Lock()
+	err := d.startContainerTaskWithIntent(context.Background(), ctr, tsk, time.Now())
+	assert.Check(t, err != nil)
+	assert.Equal(t, tsk.starts, 1)
+	d.checkpointContainerStartFailure(context.Background(), ctr, err)
+	ctr.Unlock()
+
+	loaded := reloadStartIntentContainer(t, ctr)
+	assert.Assert(t, !loaded.HasStartIntent())
+	assert.Check(t, is.Contains(loaded.State.ErrorMsg, "synthetic task start failure"))
+	assert.Check(t, loaded.State.ExitCode != 0)
+}
+
+func TestSuccessfulStartCheckpointClearsIntentOnDisk(t *testing.T) {
+	d, ctr := newStartIntentDaemon(t)
+	startedAt := time.Date(2026, 9, 5, 4, 33, 3, 0, time.UTC)
+	tsk := &startIntentMockTask{pid: 733}
+
+	ctr.Lock()
+	assert.NilError(t, d.startContainerTaskWithIntent(context.Background(), ctr, tsk, startedAt))
+	assert.Assert(t, ctr.HasStartIntent())
+	d.checkpointContainerRunning(context.Background(), ctr, &startIntentMockContainer{}, tsk, startedAt)
+	ctr.Unlock()
+
+	loaded := reloadStartIntentContainer(t, ctr)
+	assert.Assert(t, !loaded.HasStartIntent())
+	assert.Equal(t, loaded.State.State(), containertypes.StateRunning)
+	assert.Equal(t, loaded.State.Pid, 733)
+	assert.Assert(t, loaded.State.StartedAt.Equal(startedAt))
+}
+
+func TestReconcileStartIntentWithNoTaskMarksExitedWithoutDeletingContainer(t *testing.T) {
+	_, ctr := newStartIntentDaemon(t)
+	d := setupFakeDaemon(t, ctr)
+	replica, err := container.NewViewDB()
+	assert.NilError(t, err)
+	d.containersReplica = replica
+	startedAt := time.Date(2026, 9, 5, 4, 33, 3, 0, time.UTC)
+
+	ctr.Lock()
+	ctr.SetStartIntent(startedAt)
+	assert.NilError(t, ctr.CheckpointTo(context.Background(), d.containersReplica))
+	ctr.Unlock()
+	d.reconcileStartIntentAfterRestore(context.Background(), ctr, true, containerd.Stopped, nil)
+
+	loaded := reloadStartIntentContainer(t, ctr)
+	assert.Equal(t, loaded.State.State(), containertypes.StateExited)
+	assert.Assert(t, strings.HasPrefix(loaded.State.String(), "Exited (255)"))
+	assert.Assert(t, !loaded.State.IsRunning())
+	assert.Equal(t, loaded.State.ExitCode, startIntentInterruptedExitCode)
+	assert.Assert(t, loaded.State.StartedAt.Equal(startedAt))
+	assert.Check(t, is.Contains(loaded.State.ErrorMsg, errStartIntentInterrupted.Error()))
+	assert.Assert(t, !loaded.HasStartIntent())
+	assert.Check(t, loaded.HasBeenStartedBefore)
+	assert.Check(t, is.Equal(false, loaded.State.Dead))
+	assert.Check(t, is.Equal(false, loaded.State.Removed))
+	_, err = os.Stat(ctr.Root)
+	assert.NilError(t, err)
+}
+
+func TestReconcileStartIntentWithLiveTaskRestoresRunningAndClearsIntent(t *testing.T) {
+	_, ctr := newStartIntentDaemon(t)
+	startedAt := time.Date(2026, 9, 5, 4, 33, 3, 0, time.UTC)
+
+	ctr.Lock()
+	ctr.SetStartIntent(startedAt)
+	ctr.State.SetRunningExternal(&startIntentMockContainer{}, &startIntentMockTask{pid: 733})
+	ctr.State.Running = false
+	action := reconcileStartIntentStateAfterRestore(ctr, true, containerd.Running, nil)
+	ctr.Unlock()
+
+	assert.Equal(t, action, startIntentRestoreRunning)
+	assert.Assert(t, ctr.State.IsRunning())
+	assert.Equal(t, ctr.State.Pid, 733)
+	assert.Assert(t, ctr.State.StartedAt.Equal(startedAt))
+	assert.Assert(t, !ctr.HasStartIntent())
+	assert.Check(t, ctr.HasBeenStartedBefore)
+}
+
+func TestReconcileStartIntentAlreadyRunningClearsIntentOnDisk(t *testing.T) {
+	_, ctr := newStartIntentDaemon(t)
+	d := setupFakeDaemon(t, ctr)
+	replica, err := container.NewViewDB()
+	assert.NilError(t, err)
+	d.containersReplica = replica
+	startedAt := time.Date(2026, 9, 5, 4, 33, 3, 0, time.UTC)
+
+	ctr.Lock()
+	ctr.SetStartIntent(startedAt)
+	ctr.State.SetRunning(nil, &startIntentMockTask{pid: 733}, startedAt)
+	assert.NilError(t, ctr.CheckpointTo(context.Background(), d.containersReplica))
+	ctr.Unlock()
+	d.reconcileStartIntentAfterRestore(context.Background(), ctr, true, containerd.Running, nil)
+
+	loaded := reloadStartIntentContainer(t, ctr)
+	assert.Assert(t, !loaded.HasStartIntent())
+	assert.Equal(t, loaded.State.State(), containertypes.StateRunning)
+}
+
+func TestReconcileStartIntentIndeterminateStatusRetainsIntentOnDisk(t *testing.T) {
+	statuses := []struct {
+		name   string
+		known  bool
+		status containerd.ProcessStatus
+	}{
+		{name: "lookup-failure", known: false, status: containerd.Unknown},
+		{name: "unknown", known: true, status: containerd.Unknown},
+		{name: "empty", known: true, status: ""},
+		{name: "future", known: true, status: "future-status"},
+	}
+
+	for _, tc := range statuses {
+		t.Run(tc.name, func(t *testing.T) {
+			_, ctr := newStartIntentDaemon(t)
+			d := setupFakeDaemon(t, ctr)
+			replica, err := container.NewViewDB()
+			assert.NilError(t, err)
+			d.containersReplica = replica
+			startedAt := time.Date(2026, 9, 5, 4, 33, 3, 0, time.UTC)
+
+			ctr.Lock()
+			ctr.SetStartIntent(startedAt)
+			assert.NilError(t, ctr.CheckpointTo(context.Background(), d.containersReplica))
+			ctr.Unlock()
+			d.reconcileStartIntentAfterRestore(context.Background(), ctr, tc.known, tc.status, nil)
+
+			loaded := reloadStartIntentContainer(t, ctr)
+			assert.Assert(t, loaded.HasStartIntent())
+			assert.Assert(t, loaded.StartIntent.StartedAt.Equal(startedAt))
+			assert.Equal(t, loaded.State.State(), containertypes.StateCreated)
+		})
+	}
+}
+
+func TestReconcileStartIntentCreatedTaskDoesNotPromoteRunning(t *testing.T) {
+	_, ctr := newStartIntentDaemon(t)
+	ctr.Lock()
+	ctr.SetStartIntent(time.Now())
+	ctr.State.SetRunningExternal(&startIntentMockContainer{}, &startIntentMockTask{pid: 733})
+	ctr.State.Running = false
+	action := reconcileStartIntentStateAfterRestore(ctr, true, containerd.Created, nil)
+	ctr.Unlock()
+
+	assert.Equal(t, action, startIntentRestoreCleared)
+	assert.Assert(t, !ctr.HasStartIntent())
+	assert.Assert(t, !ctr.State.IsRunning())
+	assert.Equal(t, ctr.State.State(), containertypes.StateCreated)
+}
