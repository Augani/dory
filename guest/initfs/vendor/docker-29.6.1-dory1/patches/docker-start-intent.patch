+)
+
+func TestStartIntentCheckpointsAndLoadsFromDisk(t *testing.T) {
+	db, err := NewViewDB()
+	assert.NilError(t, err)
+
+	root := t.TempDir()
+	ctr := newContainer(t, root)
+	ctr.Config = &containertypes.Config{}
+	ctr.HostConfig = &containertypes.HostConfig{}
+	startedAt := time.Date(2026, 9, 5, 4, 33, 3, 800539944, time.UTC)
+
+	ctr.Lock()
+	ctr.SetStartIntent(startedAt)
+	assert.NilError(t, ctr.CheckpointTo(context.Background(), db))
+	ctr.Unlock()
+
+	data, err := os.ReadFile(filepath.Join(ctr.Root, configFileName))
+	assert.NilError(t, err)
+	var raw struct {
+		StartIntent *StartIntent
+	}
+	assert.NilError(t, json.Unmarshal(data, &raw))
+	assert.Assert(t, raw.StartIntent != nil)
+	assert.Assert(t, raw.StartIntent.StartedAt.Equal(startedAt))
+
+	loaded := NewBaseContainer(ctr.ID, ctr.Root)
+	assert.NilError(t, loaded.FromDisk())
+	assert.Assert(t, loaded.StartIntent != nil)
+	assert.Assert(t, loaded.StartIntent.StartedAt.Equal(startedAt))
+}
+
+func TestClearStartIntentRemovesCheckpointField(t *testing.T) {
+	db, err := NewViewDB()
+	assert.NilError(t, err)
+
+	root := t.TempDir()
+	ctr := newContainer(t, root)
+	ctr.Config = &containertypes.Config{}
+	ctr.HostConfig = &containertypes.HostConfig{}
+
+	ctr.Lock()
+	ctr.SetStartIntent(time.Now())
+	ctr.ClearStartIntent()
+	assert.NilError(t, ctr.CheckpointTo(context.Background(), db))
+	ctr.Unlock()
+
+	data, err := os.ReadFile(filepath.Join(ctr.Root, configFileName))
+	assert.NilError(t, err)
+	var raw map[string]any
+	assert.NilError(t, json.Unmarshal(data, &raw))
+	_, present := raw["StartIntent"]
+	assert.Check(t, is.Equal(false, present))
+}
