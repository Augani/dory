diff --git a/daemon/start_intent.go b/daemon/start_intent.go
new file mode 100644
index 0000000..6469742
--- /dev/null
+++ b/daemon/start_intent.go
@@ -0,0 +1,156 @@
+package daemon
+
+import (
+	"context"
+	"time"
+
+	containerd "github.com/containerd/containerd/v2/client"
+	"github.com/containerd/log"
+	"github.com/moby/moby/v2/daemon/container"
+	libcontainerdtypes "github.com/moby/moby/v2/daemon/internal/libcontainerd/types"
+	"github.com/pkg/errors"
+)
+
+const startIntentInterruptedExitCode = 255
+
+type startIntentRestoreAction int
+
+const (
+	startIntentRestoreNoop startIntentRestoreAction = iota
+	startIntentRestoreRunning
+	startIntentRestoreInterrupted
+	startIntentRestoreCleared
+)
+
+var errStartIntentInterrupted = errors.New("container start was interrupted before Docker checkpointed running state")
+
+func (daemon *Daemon) startContainerTaskWithIntent(ctx context.Context, ctr *container.Container, tsk libcontainerdtypes.Task, startupTime time.Time) error {
+	ctr.SetStartIntent(startupTime)
+	if err := ctr.CheckpointTo(context.WithoutCancel(ctx), daemon.containersReplica); err != nil {
+		ctr.ClearStartIntent()
+		return errors.Wrap(err, "failed to checkpoint container start intent")
+	}
+	if err := tsk.Start(context.WithoutCancel(ctx)); err != nil {
+		return setExitCodeFromError(ctr.State.SetExitCode, err)
+	}
+	return nil
+}
+
+func (daemon *Daemon) checkpointContainerStartFailure(ctx context.Context, ctr *container.Container, startErr error) {
+	ctr.ClearStartIntent()
+	ctr.State.SetError(startErr)
+	// if no one else has set it, make sure we don't leave it at zero
+	if ctr.State.ExitCode == 0 {
+		ctr.State.SetExitCode(exitUnknown)
+	}
+	if err := ctr.CheckpointTo(context.WithoutCancel(ctx), daemon.containersReplica); err != nil {
+		log.G(ctx).Errorf("%s: failed saving state on start failure: %v", ctr.ID, err)
+	}
+}
+
+func (daemon *Daemon) checkpointContainerRunning(ctx context.Context, ctr *container.Container, c8dCtr libcontainerdtypes.Container, tsk libcontainerdtypes.Task, startupTime time.Time) {
+	ctr.HasBeenManuallyRestarted = false
+	ctr.ClearStartIntent()
+	ctr.State.SetRunning(c8dCtr, tsk, startupTime)
+	ctr.HasBeenStartedBefore = true
+	daemon.setStateCounter(ctr)
+
+	daemon.initHealthMonitor(ctr)
+
+	if err := ctr.CheckpointTo(context.WithoutCancel(ctx), daemon.containersReplica); err != nil {
+		log.G(ctx).WithError(err).WithField("container", ctr.ID).Errorf("failed to store container")
+	}
+}
+
+// startIntentTaskIsRunning reports whether containerd says the task reached an
+// executing state. Created and Unknown are deliberately excluded so Docker does
+// not promote an unstarted or indeterminate task to running while reconciling a
+// pre-running-checkpoint start intent.
+func startIntentTaskIsRunning(status containerd.ProcessStatus) bool {
+	switch status {
+	case containerd.Running, containerd.Paused, containerd.Pausing:
+		return true
+	default:
+		return false
+	}
+}
+
+// reconcileStartIntentStateAfterRestore resolves a durable pre-start intent that
+// was checkpointed before Task.Start, but whose later running-state checkpoint
+// was not durably committed before daemon restore.
+func reconcileStartIntentStateAfterRestore(ctr *container.Container, taskStatusKnown bool, taskStatus containerd.ProcessStatus, exitStatus *containerd.ExitStatus) startIntentRestoreAction {
+	if !ctr.HasStartIntent() {
+		return startIntentRestoreNoop
+	}
+	if ctr.State.Running || ctr.State.Paused {
+		ctr.ClearStartIntent()
+		return startIntentRestoreCleared
+	}
+	if !taskStatusKnown {
+		return startIntentRestoreNoop
+	}
+
+	if startIntentTaskIsRunning(taskStatus) {
+		c8dCtr, hasContainer := ctr.State.C8dContainer()
+		tsk, hasTask := ctr.State.Task()
+		if hasContainer && hasTask {
+			startedAt := ctr.StartIntent.StartedAt
+			ctr.State.SetRunningExternal(c8dCtr, tsk)
+			if taskStatus == containerd.Paused || taskStatus == containerd.Pausing {
+				ctr.State.Paused = true
+			}
+			if !startedAt.IsZero() {
+				ctr.State.StartedAt = startedAt.UTC()
+			}
+			ctr.HasBeenStartedBefore = true
+			ctr.ClearStartIntent()
+			return startIntentRestoreRunning
+		}
+		return startIntentRestoreNoop
+	}
+	if taskStatus == containerd.Created {
+		ctr.ClearStartIntent()
+		return startIntentRestoreCleared
+	}
+	if taskStatus != containerd.Stopped {
+		return startIntentRestoreNoop
+	}
+
+	startedAt := ctr.StartIntent.StartedAt
+	interruptedExit := container.ExitStatus{ExitCode: startIntentInterruptedExitCode}
+	if exitStatus != nil {
+		interruptedExit.ExitCode = int(exitStatus.ExitCode())
+		interruptedExit.ExitedAt = exitStatus.ExitTime()
+	}
+	ctr.State.SetStopped(&interruptedExit)
+	if !startedAt.IsZero() {
+		ctr.State.StartedAt = startedAt.UTC()
+	}
+	ctr.State.SetError(errStartIntentInterrupted)
+	ctr.HasBeenStartedBefore = true
+	ctr.ClearStartIntent()
+	return startIntentRestoreInterrupted
+}
+
+func (daemon *Daemon) reconcileStartIntentAfterRestore(ctx context.Context, ctr *container.Container, taskStatusKnown bool, taskStatus containerd.ProcessStatus, exitStatus *containerd.ExitStatus) {
+	ctr.Lock()
+	action := reconcileStartIntentStateAfterRestore(ctr, taskStatusKnown, taskStatus, exitStatus)
+	switch action {
+	case startIntentRestoreRunning:
+		daemon.setStateCounter(ctr)
+		daemon.initHealthMonitor(ctr)
+	case startIntentRestoreInterrupted:
+		daemon.setStateCounter(ctr)
+		daemon.Cleanup(ctx, ctr)
+	case startIntentRestoreCleared:
+		// The ordinary restore path already owns the running/paused state. Only remove
+		// the stale intent marker so the next checkpoint cannot resurrect it.
+	case startIntentRestoreNoop:
+		ctr.Unlock()
+		return
+	}
+	if err := ctr.CheckpointTo(ctx, daemon.containersReplica); err != nil {
+		log.G(ctx).WithError(err).WithField("container", ctr.ID).Error("failed to checkpoint restored start intent")
+	}
+	ctr.Unlock()
+}
