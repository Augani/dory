#!/bin/sh
set -e

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
fi
if command -v udevadm >/dev/null 2>&1; then
  udevadm control --reload-rules || true
fi
if [ "$1" = purge ]; then
  # This optional restriction is administrator-authored (or migrated from an older package),
  # not a file owned by the current package. Leave it for an explicit administrator decision.
  rmdir /var/lib/dory 2>/dev/null || true
fi

#DEBHELPER#
