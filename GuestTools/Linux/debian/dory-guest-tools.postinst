#!/bin/sh
set -e

install -d -m 0755 /var/lib/dory

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
  systemctl enable --now dory-agent.service || true
  systemctl --global enable dory-clipboard.service || true
  # Global enablement covers future graphical logins. Start the user service for every current
  # graphical user manager too; package-install order must not choose a preferred account.
  if command -v loginctl >/dev/null 2>&1; then
    for uid in $(loginctl list-users --no-legend --no-pager 2>/dev/null | awk '{ print $1 }'); do
      case "$uid" in ''|*[!0-9]*) continue ;; esac
      [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] || continue
      user="$(getent passwd "$uid" | cut -d: -f1)"
      [ -n "$user" ] || continue
      runtime="/run/user/$uid"
      [ -S "$runtime/bus" ] || continue
      runuser -u "$user" -- env XDG_RUNTIME_DIR="$runtime" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
        systemctl --user is-active --quiet graphical-session.target || continue
      runuser -u "$user" -- env XDG_RUNTIME_DIR="$runtime" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
        systemctl --user start dory-clipboard.service || true
    done
  fi
fi
if command -v udevadm >/dev/null 2>&1; then
  udevadm control --reload-rules || true
fi

#DEBHELPER#
