#!/bin/bash
set -euo pipefail

operation="${1:-}"
mime="${2:-text/plain;charset=utf-8}"
case "$operation" in
  get|set|types) ;;
  *) echo "usage: dory-clipboard get|set|types [mime-type]" >&2; exit 64 ;;
esac
case "$mime" in
  text/plain|text/plain\;charset=utf-8|image/png) ;;
  *) echo "unsupported clipboard type: $mime" >&2; exit 64 ;;
esac
user="$(cat /var/lib/dory/username 2>/dev/null || true)"
if [ -z "$user" ] || ! id "$user" >/dev/null 2>&1; then
  echo "Dory clipboard user is not configured" >&2
  exit 69
fi
uid="$(id -u "$user")"
home="$(getent passwd "$user" | cut -d: -f6)"
runtime="/run/user/$uid"
[ -d "$runtime" ] || { echo "Dory clipboard user session is not active" >&2; exit 69; }
session_marker="$runtime/dory/clipboard-session"
[ -f "$session_marker" ] && [ ! -L "$session_marker" ] \
  || { echo "Dory clipboard user service is not active" >&2; exit 69; }
[ "$(stat -c %u "$session_marker" 2>/dev/null || true)" = "$uid" ] \
  || { echo "Dory clipboard session marker has the wrong owner" >&2; exit 69; }
session_pid="$(cat "$session_marker" 2>/dev/null || true)"
case "$session_pid" in
  ''|*[!0-9]*)
    echo "Dory clipboard session marker has an invalid process" >&2
    exit 69
    ;;
esac
session_process="/proc/$session_pid"
[ -r "$session_process/environ" ] \
  || { echo "Dory clipboard user service is no longer active" >&2; exit 69; }
[ "$(stat -c %u "$session_process" 2>/dev/null || true)" = "$uid" ] \
  || { echo "Dory clipboard session process has the wrong owner" >&2; exit 69; }

session_environment() {
  key="$1"
  tr '\0' '\n' < "$session_process/environ" \
    | sed -n "s/^${key}=//p" \
    | sed -n '1p'
}

run_as_user() {
  runuser -u "$user" -- env \
    HOME="$home" \
    USER="$user" \
    LOGNAME="$user" \
    XDG_RUNTIME_DIR="$runtime" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" \
    "$@"
}

wayland_socket="$(session_environment WAYLAND_DISPLAY)"
case "$wayland_socket" in
  */*) wayland_socket="" ;;
esac

if [ -n "$wayland_socket" ] && [ -S "$runtime/$wayland_socket" ] \
  && command -v wl-copy >/dev/null 2>&1 \
  && command -v wl-paste >/dev/null 2>&1; then
  case "$operation" in
    set) run_as_user env WAYLAND_DISPLAY="$wayland_socket" wl-copy --type "$mime" ;;
    get) run_as_user env WAYLAND_DISPLAY="$wayland_socket" wl-paste --no-newline --type "$mime" ;;
    types) run_as_user env WAYLAND_DISPLAY="$wayland_socket" wl-paste --list-types ;;
  esac
  exit $?
fi

command -v xclip >/dev/null 2>&1 \
  || { echo "no supported Wayland or X11 clipboard backend is installed" >&2; exit 69; }
display="$(session_environment DISPLAY)"
printf '%s\n' "$display" | grep -Eq '^:[0-9]+(\.[0-9]+)?$' \
  || { echo "Dory clipboard user service has no local X11 display" >&2; exit 69; }
xauthority="$(session_environment XAUTHORITY)"
if [ -z "$xauthority" ] && [ -f "$runtime/gdm/Xauthority" ]; then
  xauthority="$runtime/gdm/Xauthority"
fi
if [ -z "$xauthority" ] && [ -f "$home/.Xauthority" ]; then
  xauthority="$home/.Xauthority"
fi
case "$xauthority" in
  /*) ;;
  *) echo "Dory clipboard user service has no X11 authority" >&2; exit 69 ;;
esac
[ -f "$xauthority" ] && [ ! -L "$xauthority" ] \
  && [ "$(stat -c %u "$xauthority" 2>/dev/null || true)" = "$uid" ] \
  || { echo "Dory clipboard X11 authority is invalid" >&2; exit 69; }
x11_env=(DISPLAY="$display" XAUTHORITY="$xauthority")
x11_target="$mime"
case "$mime" in
  text/plain|text/plain\;charset=utf-8) x11_target="UTF8_STRING" ;;
esac
case "$operation" in
  set) run_as_user env "${x11_env[@]}" xclip -selection clipboard -in -target "$x11_target" ;;
  get) run_as_user env "${x11_env[@]}" xclip -selection clipboard -out -target "$x11_target" ;;
  types) run_as_user env "${x11_env[@]}" xclip -selection clipboard -out -target TARGETS ;;
esac
