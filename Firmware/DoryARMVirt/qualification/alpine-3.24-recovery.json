{
  "schemaVersion": 1,
  "qualificationTarget": {
    "guestFamily": "alpine",
    "guestVersion": "3.24.1",
    "guestBuild": "3.24.1",
    "guestArchitecture": "arm64"
  },
  "steps": [
    {
      "waitFor": "localhost login:",
      "send": "root\n"
    },
    {
      "waitFor": "localhost:~#",
      "send": "ip link set eth0 up && udhcpc -i eth0 -n -q && printf 'https://dl-cdn.alpinelinux.org/alpine/v3.24/main\\n' > /etc/apk/repositories && apk add --no-cache dosfstools e2fsprogs grub-efi sfdisk && ERASE_DISKS=/dev/vda setup-disk -m sys -s 0 /dev/vda\n"
    },
    {
      "waitFor": "Installation is complete",
      "send": "reboot\n",
      "installerMediaAfterSend": "detached"
    },
    {
      "waitFor": "localhost login:",
      "send": "root\n"
    },
    {
      "waitFor": "localhost:~#",
      "send": "touch /root/DORY_RECOVERY_SENTINEL && sync && reboot\n",
      "installerMediaAfterSend": "attached"
    },
    {
      "waitFor": "Press ESCAPE for boot options",
      "send": "\u001b"
    },
    {
      "waitFor": "Device Manager",
      "send": "\u001b[B\u001b[B\r"
    },
    {
      "waitFor": "UEFI Misc Device 2",
      "send": "\u001b[B\u001b[B\r"
    },
    {
      "waitFor": "localhost login:",
      "send": "root\n"
    },
    {
      "waitFor": "localhost:~#",
      "send": "! grep -q '^/dev/vda2 / ' /proc/mounts && mkdir -p /mnt/recovery && mount -o ro /dev/vda2 /mnt/recovery && test -f /mnt/recovery/root/DORY_RECOVERY_SENTINEL && printf 'DORY_%s\\n' RECOVERY_READY\n"
    }
  ]
}
