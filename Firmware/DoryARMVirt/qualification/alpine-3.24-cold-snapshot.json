{
  "schemaVersion": 1,
  "steps": [
    {
      "waitFor": "localhost login:",
      "send": "root\n"
    },
    {
      "waitFor": "localhost:~#",
      "send": "ip link set eth0 up && udhcpc -i eth0 -n -q && printf 'https://dl-cdn.alpinelinux.org/alpine/v3.24/main\\n' > /etc/apk/repositories && apk add --no-cache dosfstools e2fsprogs grub-efi sfdisk && ERASE_DISKS=/dev/vda setup-disk -m sys -s 0 /dev/vda\n"
    },
    {
      "waitFor": "Installation is complete",
      "send": "reboot\n",
      "installerMediaAfterSend": "detached"
    },
    {
      "waitFor": "localhost login:",
      "send": "root\n"
    },
    {
      "waitFor": "localhost:~#",
      "send": "touch /root/DORY_SNAPSHOT_BASE && sync && poweroff\n",
      "afterGuestStop": "capture-cold-snapshot"
    },
    {
      "waitFor": "localhost login:",
      "send": "root\n"
    },
    {
      "waitFor": "localhost:~#",
      "send": "rm /root/DORY_SNAPSHOT_BASE && touch /root/DORY_POST_SNAPSHOT && sync && poweroff\n",
      "afterGuestStop": "restore-cold-snapshot"
    },
    {
      "waitFor": "localhost login:",
      "send": "root\n"
    },
    {
      "waitFor": "localhost:~#",
      "send": "test -f /root/DORY_SNAPSHOT_BASE && test ! -e /root/DORY_POST_SNAPSHOT && printf 'DORY_%s\\n' COLD_SNAPSHOT_RESTORED\n"
    }
  ]
}
