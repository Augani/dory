{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dev.dory:virtualization-evidence:1",
  "title": "Dory subsystem evidence envelope",
  "description": "One envelope per subsystem. Historical tool receipts remain immutable, hash-bound artifacts. Schema validity is not behavioral or release qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "subsystem",
    "issueLabel",
    "planItems",
    "sourceCommit",
    "cells",
    "host",
    "status",
    "scope",
    "releaseQualified",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "dev.dory.virtualization-evidence"
    },
    "subsystem": {
      "enum": [
        "cpu",
        "native",
        "firmware",
        "devices",
        "graphics",
        "macos",
        "control",
        "storage",
        "network",
        "guest-tools",
        "qualification"
      ]
    },
    "issueLabel": {
      "enum": [
        "subsystem:cpu",
        "subsystem:native",
        "subsystem:firmware",
        "subsystem:devices",
        "subsystem:graphics",
        "subsystem:macos",
        "subsystem:control",
        "subsystem:storage",
        "subsystem:network",
        "subsystem:guest-tools",
        "subsystem:qualification"
      ]
    },
    "planItems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^P[0-9]{2}(?:-[0-9]{2})?$"
      }
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "linux-arm64-native",
          "linux-x86_64-translated",
          "macos-arm64-vzmac"
        ]
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "version",
        "build",
        "classification",
        "xcodeBuild",
        "sdk"
      ],
      "properties": {
        "architecture": {
          "const": "arm64"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "experimental",
            "public"
          ]
        },
        "xcodeBuild": {
          "type": "string",
          "minLength": 1
        },
        "sdk": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "baseline-recorded",
        "passed",
        "failed",
        "skipped",
        "not-run"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "releaseQualified": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9_. /-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "subsystem": {
            "const": "cpu"
          }
        }
      },
      "then": {
        "properties": {
          "issueLabel": {
            "const": "subsystem:cpu"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subsystem": {
            "const": "native"
          }
        }
      },
      "then": {
        "properties": {
          "issueLabel": {
            "const": "subsystem:native"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subsystem": {
            "const": "firmware"
          }
        }
      },
      "then": {
        "properties": {
          "issueLabel": {
            "const": "subsystem:firmware"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subsystem": {
            "const": "devices"
          }
        }
      },
      "then": {
        "properties": {
          "issueLabel": {
            "const": "subsystem:devices"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subsystem": {
            "const": "graphics"
          }
        }
      },
      "then": {
        "properties": {
          "issueLabel": {
            "const": "subsystem:graphics"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subsystem": {
            "const": "macos"
          }
        }
      },
      "then": {
        "properties": {
          "issueLabel": {
            "const": "subsystem:macos"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subsystem": {
            "const": "control"
          }
        }
      },
      "then": {
        "properties": {
          "issueLabel": {
            "const": "subsystem:control"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subsystem": {
            "const": "storage"
          }
        }
      },
      "then": {
        "properties": {
          "issueLabel": {
            "const": "subsystem:storage"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subsystem": {
            "const": "network"
          }
        }
      },
      "then": {
        "properties": {
          "issueLabel": {
            "const": "subsystem:network"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subsystem": {
            "const": "guest-tools"
          }
        }
      },
      "then": {
        "properties": {
          "issueLabel": {
            "const": "subsystem:guest-tools"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subsystem": {
            "const": "qualification"
          }
        }
      },
      "then": {
        "properties": {
          "issueLabel": {
            "const": "subsystem:qualification"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "releaseQualified": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "passed"
          },
          "host": {
            "properties": {
              "classification": {
                "const": "public"
              }
            }
          }
        }
      }
    }
  ]
}
